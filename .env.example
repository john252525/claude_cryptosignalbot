# --- Telegram ingestion ---
# At least one source must be enabled.

# Telethon user-account source (for reading public/joined channels directly).
# Get api_id/api_hash at https://my.telegram.org -> API development tools.
TELETHON_ENABLED=false
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_PHONE=
TELETHON_SESSION_NAME=signals
# Session string (preferred): run `python scripts/get_telethon_session.py` once to get this.
# If set, session is stored in memory and no interactive login needed on restart.
# If empty, session is file-based at ./data/<TELETHON_SESSION_NAME>.session
TELETHON_SESSION_STRING=
# Comma-separated channel usernames or invite links (without @).
# Example: daytrader_signals,binance_killers_official
TELETHON_CHANNELS=

# Bot source (user forwards messages here).
# Create via @BotFather. Only forwarded messages from configured users are processed.
BOT_ENABLED=false
BOT_TOKEN=
# Comma-separated Telegram user IDs (numeric). Get yours at @userinfobot.
BOT_ALLOWED_USERS=

# --- Signal parsing (LLM) ---
# Provider: "anthropic" | "deepseek" | "auto" (auto picks whichever key is set).
LLM_PROVIDER=auto

# Anthropic (Claude). ~$0.001 per parsed message with Haiku 4.5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# DeepSeek (OpenAI-compatible). ~3-4x cheaper than Claude Haiku.
# Get key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Exchange (price feed) ---
EXCHANGE=binance
# "futures" or "spot". Most signal channels target USDT-M perpetuals.
EXCHANGE_MARKET=futures

# --- Web dashboard ---
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Railway/Heroku will set PORT automatically; it takes precedence over WEB_PORT.

# --- Storage ---
# SQLite (default, dev): sqlite+aiosqlite:///./data/signals.db
# Postgres (Railway): postgresql://user:pass@host:port/dbname
#   The "+asyncpg" driver is added automatically.
DATABASE_URL=sqlite+aiosqlite:///./data/signals.db

# --- Behaviour ---
# When entry is a range, signal becomes ACTIVE if price touches the range.
# When entry is single price, signal becomes ACTIVE if price crosses it within tolerance (pct).
ENTRY_TOLERANCE_PCT=0.2
# Signals older than this with no entry hit are marked EXPIRED.
SIGNAL_TTL_HOURS=48
# Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
